# Copy to .env and fill in. Never commit .env.
# Gemini is used when GEMINI_API_KEY is set; otherwise Groq is used.
GEMINI_API_KEY=your-gemini-key-here
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Optional: comma-separated User IDs that become admins when they register.
# If neither this nor ADMIN_USER_ID is set, the first account created becomes the admin.
ADMIN_USER_IDS=
# Optional default admin, created or corrected on every start (password min 8 characters).
# The password is managed here, so it cannot be changed inside the app; edit this value
# and restart instead. Set it in .env or platform secrets only - never in source code.
ADMIN_USER_ID=admin
ADMIN_PASSWORD=
